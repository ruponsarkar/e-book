{
  "expo": {
    "name": "Exam Books",
    "slug": "exam-books",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.pageuptech.exambooks",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F3A5F"
      },
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "com.pageuptech.exambooks",
      "supportsTablet": true
    },
    "extra": {
      "apiUrl": "http://72.62.75.203:4000"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}

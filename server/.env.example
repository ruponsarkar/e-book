# Copy this file to .env and fill in real values.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ebook
# Use a long random string (at least 32 characters). Never commit the real one.
JWT_SECRET=change-me-to-a-long-random-string
# How long a login stays valid before the user must sign in again.
JWT_EXPIRES_IN=30d
# Set to true only if students may create their own accounts. Otherwise the admin creates them.
ALLOW_SIGNUP=false
# Days the app may open downloaded books offline before it must check in with the server (0 = always online).
OFFLINE_DAYS=7
# Time zone for "today" and daily charts in the admin panel.
ADMIN_TZ=Asia/Kolkata

# ---- Website (landing page, registration and payments) ----
# These are defaults only: edit them in the admin panel → Settings (no restart needed).
SITE_NAME=Exam Books
SITE_URL=https://exambook.frontwebtech.com
PRICE_INR=199
# Link sent to students with their login details.
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.pageuptech.exambooks
# Shown on the website and in the policy pages (Razorpay requires real contact details).
CONTACT_EMAIL=support@frontwebtech.com
CONTACT_PHONE=+91 90000 00000
BUSINESS_NAME=Your registered business name
BUSINESS_ADDRESS=Full postal address, Guwahati, Assam, PIN
# Hours within which the login is sent after payment (shown on the website).
LOGIN_DELIVERY_HOURS=24
# Razorpay dashboard → Account & Settings → API Keys. Use test keys (rzp_test_…) first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard → Webhooks: URL https://<your domain>/public/razorpay-webhook,
# events payment.captured and order.paid, and this secret.
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (defaults only: edit in the admin panel → Settings → Email) ----
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (SSL), false for 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Exam Books
MAIL_FROM_EMAIL=
# Comma-separated addresses that get "new registration" alerts.
ADMIN_EMAILS=
